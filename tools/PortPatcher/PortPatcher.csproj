<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Prepares your decompiled copy of the game (local/src) for the browser build.
    Patches are structural: they find code by type/method names and syntax shape (Roslyn) and add or
    wrap *this repo's* code around it, so no game code is stored in this repository.
    Run by setup.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
</Project>
