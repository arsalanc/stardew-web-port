<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Local server: hosts the Blazor client, serves your game's Content/ and the exported audio, and proxies the in-game assistant. -->
  <Import Project="..\..\build\Paths.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StardewWeb.Client\StardewWeb.Client.csproj" />
  </ItemGroup>

  <!-- Bake the paths in so `dotnet run` works without arguments (the content and audio command-line options override them). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameContentDir</_Parameter1>
      <_Parameter2>$(GameDir)\Content</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameAudioDir</_Parameter1>
      <_Parameter2>$(GameAudioDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
